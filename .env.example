# ==============================================================================
# Application Configuration
# ==============================================================================
APP_ENV=development
DEBUG=True
PROJECT_NAME="Financial Document Intelligence System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# ==============================================================================
# Server & CORS
# ==============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Comma-separated list of allowed origins or JSON array
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# ==============================================================================
# PostgreSQL & pgvector Database
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_intel
# Async database URL for FastAPI SQLAlchemy async sessions
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intel
# Sync database URL for migrations / Celery workers
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/doc_intel

# ==============================================================================
# Redis & Background Workers (Celery vs Inline)
# ==============================================================================
# processing mode: 'inline' (development with FastAPI BackgroundTasks) or 'celery' (distributed queue)
PROCESSING_MODE=inline
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# Storage & Document Processing Engine
# ==============================================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
TESSERACT_CMD=tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
PDF_OCR_DPI=300
PDF_MIN_TEXT_CHARS_PER_PAGE=50
SPREADSHEET_CHUNK_ROW_SIZE=50
INCLUDE_HIDDEN_SHEETS=true

# ==============================================================================
# AI Extraction & Embeddings (Configurable - Never hardcode keys)
# ==============================================================================
LLM_ENABLED=true
# Supported LLM providers: gemini, openai, anthropic, mock
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
GOOGLE_GENAI_API_VERSION=v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# LLM Processing Parameters
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=30000
LLM_MAX_OUTPUT_TOKENS=8000
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# Supported Embedding providers: gemini, openai, huggingface, mock
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ==============================================================================
# Frontend Environment Variables (Vite requires VITE_ prefix)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
